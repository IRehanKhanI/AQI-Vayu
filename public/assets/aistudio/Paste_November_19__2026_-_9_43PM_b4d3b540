<script>
  (function() {
    const sliders = {
      pm25: document.getElementById('range-pm25'),
      pm10: document.getElementById('range-pm10'),
      no2: document.getElementById('range-no2'),
      so2: document.getElementById('range-so2'),
      co: document.getElementById('range-co'),
      o3: document.getElementById('range-o3')
    };

    const displays = {
      pm25: document.getElementById('val-pm25'),
      pm10: document.getElementById('val-pm10'),
      no2: document.getElementById('val-no2'),
      so2: document.getElementById('val-so2'),
      co: document.getElementById('val-co'),
      o3: document.getElementById('val-o3')
    };

    const aqiScore = document.getElementById('predicted-aqi-score');
    const riskBadge = document.getElementById('risk-category-badge');
    const advisoryText = document.getElementById('health-advisory-text');
    const confidencePct = document.getElementById('confidence-percentage');
    const confidenceBar = document.getElementById('confidence-bar');
    const predictBtn = document.getElementById('btn-predict');

    // Update numbers on input
    Object.keys(sliders).forEach(key => {
      sliders[key].addEventListener('input', (e) => {
        displays[key].textContent = e.target.value;
      });
    });

    function calculateSimulatedAQI() {
      const pm25 = parseFloat(sliders.pm25.value);
      const pm10 = parseFloat(sliders.pm10.value);
      const no2 = parseFloat(sliders.no2.value);
      const so2 = parseFloat(sliders.so2.value);
      const co = parseFloat(sliders.co.value);
      const o3 = parseFloat(sliders.o3.value);

      // CPCB sub-index weighted heuristic representation
      const subPM25 = pm25 * 1.35;
      const subPM10 = pm10 * 0.75;
      const subNO2 = no2 * 0.9;
      const subCO = co * 28;
      const subSO2 = so2 * 0.8;
      const subO3 = o3 * 0.85;

      const calc = Math.round(Math.max(subPM25, subPM10, (subPM25 + subPM10 + subNO2 + subCO + subSO2 + subO3) / 2.6));
      const finalAQI = Math.min(Math.max(calc, 25), 498);

      aqiScore.textContent = finalAQI;

      if (finalAQI <= 50) {
        riskBadge.textContent = 'GOOD / SAFE';
        riskBadge.className = 'px-3.5 py-1.5 rounded-xl bg-[#1C3E20] border border-[#488B52]/50 text-[#8CE698] font-label-md text-label-md text-center font-bold shadow-[2px_3px_8px_rgba(0,0,0,0.4),inset_0_1px_1px_rgba(255,255,255,0.2)]';
        advisoryText.textContent = 'Ideal ambient conditions. Great time for morning jogs, open balcony ventilation, and outdoor exercise with minimal risk.';
        confidencePct.textContent = '96.8%';
        confidenceBar.style.width = '96.8%';
      } else if (finalAQI <= 100) {
        riskBadge.textContent = 'SATISFACTORY';
        riskBadge.className = 'px-3.5 py-1.5 rounded-xl bg-[#36421D] border border-[#606C38]/60 text-[#DBE9A9] font-label-md text-label-md text-center font-bold shadow-[2px_3px_8px_rgba(0,0,0,0.4),inset_0_1px_1px_rgba(255,255,255,0.2)]';
        advisoryText.textContent = 'Air quality is acceptable; minor breathing discomfort possible for sensitive individuals during intensive endurance sports.';
        confidencePct.textContent = '95.1%';
        confidenceBar.style.width = '95.1%';
      } else if (finalAQI <= 200) {
        riskBadge.textContent = 'MODERATE';
        riskBadge.className = 'px-3.5 py-1.5 rounded-xl bg-[#4A3212] border border-[#DDA15E]/50 text-[#FFDCBB] font-label-md text-label-md text-center font-bold shadow-[2px_3px_8px_rgba(0,0,0,0.4),inset_0_1px_1px_rgba(255,255,255,0.2)]';
        advisoryText.textContent = 'May cause breathing discomfort to people with lung disease such as asthma, and discomfort to children and older adults.';
        confidencePct.textContent = '93.5%';
        confidenceBar.style.width = '93.5%';
      } else if (finalAQI <= 300) {
        riskBadge.textContent = 'VERY UNHEALTHY / POOR';
        riskBadge.className = 'px-3.5 py-1.5 rounded-xl bg-[#3E2510] border border-[#BC6C25]/50 text-[#FABA75] font-label-md text-label-md text-center font-bold shadow-[2px_3px_8px_rgba(0,0,0,0.4),inset_0_1px_1px_rgba(255,255,255,0.2)]';
        advisoryText.textContent = 'Active outdoor exercise not recommended between 06:00 - 10:00. Vulnerable populations (children, elderly, asthmatics) must stay indoors.';
        confidencePct.textContent = '94.2%';
        confidenceBar.style.width = '94.2%';
      } else {
        riskBadge.textContent = 'SEVERE / HAZARDOUS';
        riskBadge.className = 'px-3.5 py-1.5 rounded-xl bg-[#4A1414] border border-red-500/60 text-[#FFA0A0] font-label-md text-label-md text-center font-bold shadow-[2px_3px_8px_rgba(0,0,0,0.4),inset_0_1px_1px_rgba(255,255,255,0.2)] animate-pulse';
        advisoryText.textContent = 'Public Health Emergency Level. Heavy particulate saturation will trigger severe respiratory distress even in healthy adults. N95 respirator mandatory outdoors.';
        confidencePct.textContent = '97.4%';
        confidenceBar.style.width = '97.4%';
      }
    }

    predictBtn.addEventListener('click', () => {
      calculateSimulatedAQI();
      const outputElem = document.getElementById('prediction-result');
      outputElem.classList.add('ring-2', 'ring-[#DDA15E]');
      setTimeout(() => outputElem.classList.remove('ring-2', 'ring-[#DDA15E]'), 600);
    });

    // Preset configurations
    document.getElementById('btn-preset-stubble').addEventListener('click', () => {
      sliders.pm25.value = 260;
      sliders.pm10.value = 380;
      sliders.no2.value = 85;
      sliders.so2.value = 35;
      sliders.co.value = 3.6;
      sliders.o3.value = 45;
      Object.keys(sliders).forEach(k => displays[k].textContent = sliders[k].value);
      calculateSimulatedAQI();
    });

    document.getElementById('btn-preset-diwali').addEventListener('click', () => {
      sliders.pm25.value = 410;
      sliders.pm10.value = 540;
      sliders.no2.value = 145;
      sliders.so2.value = 92;
      sliders.co.value = 6.2;
      sliders.o3.value = 75;
      Object.keys(sliders).forEach(k => displays[k].textContent = sliders[k].value);
      calculateSimulatedAQI();
    });

    document.getElementById('btn-preset-monsoon').addEventListener('click', () => {
      sliders.pm25.value = 28;
      sliders.pm10.value = 45;
      sliders.no2.value = 20;
      sliders.so2.value = 8;
      sliders.co.value = 0.6;
      sliders.o3.value = 22;
      Object.keys(sliders).forEach(k => displays[k].textContent = sliders[k].value);
      calculateSimulatedAQI();
    });

    document.getElementById('btn-reset').addEventListener('click', () => {
      sliders.pm25.value = 140;
      sliders.pm10.value = 220;
      sliders.no2.value = 55;
      sliders.so2.value = 18;
      sliders.co.value = 1.8;
      sliders.o3.value = 38;
      Object.keys(sliders).forEach(k => displays[k].textContent = sliders[k].value);
      calculateSimulatedAQI();
    });
  })();
