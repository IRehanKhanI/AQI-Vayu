              0 1px 2px rgba(0, 0, 0, 0.25),
              inset 0 2px 2px rgba(255, 255, 255, 0.7),
              inset 0 -2px 2px rgba(0, 0, 0, 0.3);
  cursor: grab;
  position: relative;
  transition: transform 0.12s ease, box-shadow 0.12s ease;
}
input[type=range].clay-slider::-webkit-slider-thumb:active {
  cursor: grabbing;
  transform: scale(1.08);
  box-shadow: 1px 2px 4px rgba(40, 54, 24, 0.45),
              inset 0 1px 2px rgba(255, 255, 255, 0.5),
              inset 0 -2px 3px rgba(0, 0, 0, 0.4);
}

input[type=range].clay-slider::-moz-range-track {
  height: 12px;
  border-radius: 9999px;
  background: #E5DFBC;
  box-shadow: inset 2px 2px 5px rgba(40, 54, 24, 0.26),
              inset -2px -2px 5px rgba(255, 255, 255, 0.95);
  border: none;
}

input[type=range].clay-slider::-moz-range-thumb {
  width: 26px;
  height: 26px;
  border-radius: 50%;
  background: radial-gradient(circle at 35% 30%, #E6A265 0%, #BC6C25 55%, #8B4810 100%);
  border: 2px solid #FAF6DC;
  box-shadow: 2px 4px 8px rgba(40, 54, 24, 0.35),
              inset 0 2px 2px rgba(255, 255, 255, 0.7);
