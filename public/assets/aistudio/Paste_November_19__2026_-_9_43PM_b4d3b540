/* --- TACTILE NEOMORPHISM & CLAYMORPHISM TOKENS --- */
:root {
  --clay-bg: #F4EFCF;
  --clay-card: #FAF6DC;
  --clay-shadow-light: #FFFFFF;
  --clay-shadow-dark: rgba(40, 54, 24, 0.16);
  --clay-shadow-dark-strong: rgba(40, 54, 24, 0.28);
}

/* Claymorphic Elevated Elements */
.clay-card {
  background: #F8F4DA;
  box-shadow: 7px 7px 18px rgba(40, 54, 24, 0.12),
              -6px -6px 16px rgba(255, 255, 255, 0.95),
              inset 1px 1px 2px rgba(255, 255, 255, 0.9);
  border: 1px solid rgba(255, 255, 255, 0.7);
}

.clay-card-nested {
  background: #F3EFCF;
  box-shadow: 4px 4px 10px rgba(40, 54, 24, 0.09),
              -3px -3px 8px rgba(255, 255, 255, 0.95),
              inset 1px 1px 1.5px rgba(255, 255, 255, 0.85);
  border: 1px solid rgba(255, 255, 255, 0.6);
}

.clay-badge-recessed {
  box-shadow: inset 2px 2px 4px rgba(40, 54, 24, 0.25),
              inset -2px -2px 4px rgba(255, 255, 255, 0.15);
}

.clay-button-tactile {
  box-shadow: 5px 6px 14px rgba(40, 54, 24, 0.12),
              -4px -4px 10px rgba(255, 255, 255, 0.95),
              inset 0 1.5px 1px rgba(255, 255, 255, 0.9);
}
.clay-button-tactile:active {
  box-shadow: inset 2px 2px 5px rgba(40, 54, 24, 0.22),
              inset -2px -2px 5px rgba(255, 255, 255, 0.8);
  transform: translateY(1px);
}

/* Big Copperwood Pressable Button */
.clay-button-copper {
  background: linear-gradient(180deg, #CE782F 0%, #BC6C25 45%, #9E5314 100%);
  box-shadow: 0 8px 0 #7A3C08,
              0 12px 20px rgba(122, 60, 8, 0.35),
              inset 0 2px 2px rgba(255, 255, 255, 0.4),
              inset 0 -2px 4px rgba(0, 0, 0, 0.2);
  transition: all 0.1s ease;
}
.clay-button-copper:active {
  transform: translateY(6px);
  box-shadow: 0 2px 0 #7A3C08,
              0 4px 10px rgba(122, 60, 8, 0.4),
              inset 0 2px 4px rgba(0, 0, 0, 0.35);
}

/* Deep Dark Forest Sensor Box (Clay Elevated Heavy Instrument) */
.clay-hardware-dark {
  background: linear-gradient(165deg, #2D3D1B 0%, #202C13 100%);
  box-shadow: 9px 9px 24px rgba(20, 32, 5, 0.4),
              -6px -6px 18px rgba(254, 250, 224, 0.35),
              inset 1px 1px 2px rgba(255, 255, 255, 0.2),
              inset -1px -1px 3px rgba(0, 0, 0, 0.4);
  border: 1px solid rgba(255, 255, 255, 0.12);
}

.clay-hardware-well {
  box-shadow: inset 3px 3px 7px rgba(0, 0, 0, 0.45),
              inset -2px -2px 5px rgba(255, 255, 255, 0.08);
}

/* Tactile Range Sliders: Concave Debossed Tracks & Extruded Sensor Dials */
input[type=range].clay-slider {
  -webkit-appearance: none;
  appearance: none;
  background: #E5DFBC;
  height: 12px;
  border-radius: 9999px;
  box-shadow: inset 2px 2px 5px rgba(40, 54, 24, 0.26),
              inset -2px -2px 5px rgba(255, 255, 255, 0.95),
              0 1px 1px rgba(255, 255, 255, 0.6);
  outline: none;
  margin: 6px 0;
}

input[type=range].clay-slider::-webkit-slider-thumb {
  -webkit-appearance: none;
  appearance: none;
  width: 26px;
  height: 26px;
  border-radius: 50%;
  background: radial-gradient(circle at 35% 30%, #E6A265 0%, #BC6C25 55%, #8B4810 100%);
  border: 2px solid #FAF6DC;
